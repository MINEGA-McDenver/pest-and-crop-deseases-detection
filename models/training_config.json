{
  "model": "MobileNetV2",
  "num_classes": 15,
  "class_names": [
    "banana_cordana",
    "banana_healthy",
    "banana_pestalotiopsis",
    "banana_sigatoka",
    "beans_angular_leaf_spot",
    "beans_healthy",
    "beans_rust",
    "maize_common_rust",
    "maize_gray_leaf_spot",
    "maize_healthy",
    "maize_northern_leaf_blight",
    "other_leaf",
    "potato_early_blight",
    "potato_healthy",
    "potato_late_blight"
  ],
  "crops": [
    "maize",
    "banana",
    "other_leaf",
    "potato",
    "beans"
  ],
  "image_size": [
    224,
    224
  ],
  "batch_size": 8,
  "data_pipeline": {
    "data_autotune": false,
    "parallel_calls": 2,
    "prefetch": 2,
    "inter_op_threads": 2,
    "intra_op_threads": 4
  },
  "seed": 42,
  "loss": "FocalLoss(gamma=2.0, alpha=0.25, ol_smoothing=0.1)",
  "other_leaf_weight_multiplier": 1.5,
  "focus_crop_weight_multiplier": 1.0,
  "enable_focus_crop_weighting": false,
  "other_leaf_label_smoothing": 0.1,
  "other_leaf_mixup_alpha": 0.4,
  "enable_ol_mixup": true,
  "enable_ol_label_smoothing": true,
  "max_class_weight": 4.0,
  "use_last_n_unfreeze": true,
  "unfreeze_last_base_layers": 60,
  "fine_tune_from_layer": 80,
  "phase1_epochs": 15,
  "phase2_epochs": 28,
  "total_epochs": 43,
  "phase1_time_min": 623.2,
  "phase2_time_min": 1177.1,
  "total_time_min": 1800.3,
  "best_val_accuracy": 0.9729,
  "phase1_best_val": 0.9295,
  "phase2_best_val": 0.9729,
  "best_model_path": "best_model.keras",
  "final_model_path": "final_model.keras",
  "phase2_lr_schedule": "cosine_annealing",
  "calibration_defaults": {
    "min_confidence": 0.6,
    "min_margin": 0.2,
    "max_entropy": 1.5,
    "temperature": 1.0
  },
  "augmentation": {
    "crop_classes": {
      "flip": "horizontal",
      "rotation": 0.08,
      "zoom": "(-0.15, 0.15) bidirectional",
      "contrast": 0.2,
      "brightness": 0.2
    },
    "other_leaf": {
      "flip": "horizontal_and_vertical",
      "rotation": 0.15,
      "zoom": 0.15,
      "contrast": 0.4,
      "brightness": 0.3,
      "mixup_alpha": 0.4,
      "label_smoothing": 0.1
    }
  }
